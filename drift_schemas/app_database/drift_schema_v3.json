    {
      "name": "subscriptions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subscriptions\" (\"id\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"kind\" TEXT NOT NULL, \"price_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"cycle_unit\" TEXT NULL, \"cycle_count\" INTEGER NULL, \"start_date\" TEXT NULL, \"next_date\" TEXT NULL, \"end_date\" TEXT NULL, \"end_date_unknown\" INTEGER NOT NULL DEFAULT 0 CHECK (\"end_date_unknown\" IN (0, 1)), \"status\" TEXT NOT NULL, \"auto_renew\" INTEGER NOT NULL DEFAULT 1 CHECK (\"auto_renew\" IN (0, 1)), \"category_id\" TEXT NULL, \"payment_method_id\" TEXT NULL, \"account\" TEXT NULL, \"color\" INTEGER NULL, \"icon_attachment_id\" TEXT NULL, \"url\" TEXT NULL, \"notes\" TEXT NULL, \"reminder_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_enabled\" IN (0, 1)), \"reminder_days\" INTEGER NULL, \"reminder_time\" INTEGER NULL, \"trial_ends_on\" TEXT NULL, \"intro_price_minor\" INTEGER NULL, \"intro_ends_on\" TEXT NULL, \"my_share_minor\" INTEGER NULL, \"reimbursed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reimbursed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"subscription_id\" TEXT NOT NULL, \"paid_on\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"rate_to_base\" TEXT NULL, \"base_currency\" TEXT NULL, \"origin\" TEXT NOT NULL, \"note\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
